{{ 'wishlist.css' | asset_url | stylesheet_tag }}

<script>
  window.__wishlist_stock = {
    proxyBase: '/apps/wishlist-stock/api',
    customerEmail: {{ customer.email | default: nil | json }},
    customerLoggedIn: {% if customer %}true{% else %}false{% endif %},
    settings: {
      buttonColor: '{{ block.settings.wishlist_button_color | default: "#e74c3c" }}',
      buttonSize: {{ block.settings.wishlist_button_size | default: 20 }},
      drawerPosition: '{{ block.settings.drawer_position | default: "right" }}',
      notifyButtonText: {{ block.settings.notify_button_text | default: "Notify me when available" | json }},
      notifyModalTitle: {{ block.settings.notify_modal_title | default: "Get notified when this is back" | json }},
      headerLink: {% if block.settings.header_link == false %}false{% else %}true{% endif %},
      wishlistPageUrl: {{ block.settings.wishlist_page_url | default: '/pages/wishlist' | json }},
      cardHearts: {% if block.settings.card_hearts == false %}false{% else %}true{% endif %},
      productButton: {% if block.settings.product_button == false %}false{% else %}true{% endif %},
    },
  };
</script>

{%- comment -%} Wishlist Drawer – off-canvas panel {%- endcomment -%}
<div class="ws-drawer-overlay" id="ws-drawer-overlay" aria-hidden="true"></div>

<aside
  class="ws-drawer"
  id="ws-drawer"
  data-position="{{ block.settings.drawer_position | default: 'right' }}"
  role="dialog"
  aria-label="Your Wishlist"
  aria-hidden="true"
>
  <div class="ws-drawer__header">
    <h2 class="ws-drawer__title">
      My Wishlist
      <span class="ws-drawer__count" id="ws-drawer-count"></span>
    </h2>
    <button class="ws-drawer__close" id="ws-drawer-close" aria-label="Close wishlist">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="ws-drawer__body" id="ws-drawer-body">
    <div class="ws-drawer__empty" id="ws-drawer-empty" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M12 21s-6.716-4.434-9.333-7.14C-1.333 10.9 1.333 6 6 6c2.76 0 4 2 6 2s3.24-2 6-2c4.667 0 7.333 4.9 3.333 7.86C18.716 16.566 12 21 12 21z"/>
      </svg>
      <p>Your wishlist is empty</p>
    </div>
    <div id="ws-drawer-items"></div>
  </div>
</aside>

{%- comment -%} Back-in-Stock modal {%- endcomment -%}
<div class="ws-modal-overlay" id="ws-bis-modal" aria-hidden="true">
  <div class="ws-modal" role="dialog" aria-label="Back in stock notification">
    <div class="ws-modal__header">
      <h3 class="ws-modal__title">{{ block.settings.notify_modal_title | default: 'Get notified when this is back' }}</h3>
      <button class="ws-modal__close" id="ws-bis-close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="ws-modal__body" id="ws-bis-form-body">
      <p>We'll email you the moment this item is available again.</p>
      <p class="ws-modal__msg" id="ws-bis-msg" role="alert" style="display:none;"></p>
      <form class="ws-modal__form" id="ws-bis-form">
        <input type="hidden" name="variantId" value="" />
        <input type="hidden" name="productId" value="" />
        <div class="ws-hp" aria-hidden="true">
          <label for="ws-bis-website">Website</label>
          <input type="text" name="website" id="ws-bis-website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="ws-modal__field">
          <label for="ws-bis-email">Email *</label>
          <input type="email" name="email" id="ws-bis-email" placeholder="you@example.com" required autocomplete="email" />
        </div>
        <div class="ws-modal__field">
          <label for="ws-bis-phone">Phone (optional)</label>
          <input type="tel" name="phone" id="ws-bis-phone" placeholder="+1 234 567 890" autocomplete="tel" />
        </div>
      </form>
    </div>
    <div class="ws-modal__actions" id="ws-bis-actions">
      <button class="ws-btn" id="ws-bis-cancel" type="button">Cancel</button>
      <button class="ws-btn ws-btn--primary" id="ws-bis-submit" type="button">Notify Me</button>
    </div>
    <div class="ws-modal__success" id="ws-bis-success" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <h3 id="ws-bis-success-title">You're on the list!</h3>
      <p id="ws-bis-success-msg">We'll email you when this is back in stock.</p>
      <button class="ws-btn ws-btn--small ws-btn--danger" id="ws-bis-unsub" type="button" style="display:none;">Unsubscribe</button>
    </div>
  </div>
</div>

{%- comment -%} Header wishlist counter (hidden – used by JS to track count) {%- endcomment -%}
<span id="ws-header-count" class="ws-sr-only" data-count="0"></span>

<script src="{{ 'wishlist-button.js' | asset_url }}" defer></script>
<script src="{{ 'back-in-stock.js' | asset_url }}" defer></script>
<script src="{{ 'wishlist-page.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Wishlist & Stock Alerts",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "wishlist_button_color",
      "label": "Wishlist Button Color",
      "default": "#e74c3c"
    },
    {
      "type": "range",
      "id": "wishlist_button_size",
      "label": "Wishlist Icon Size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "drawer_position",
      "label": "Wishlist Drawer Position",
      "options": [
        { "label": "Right", "value": "right" },
        { "label": "Left", "value": "left" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "notify_button_text",
      "label": "Notify Button Text",
      "default": "Notify me when available"
    },
    {
      "type": "text",
      "id": "notify_modal_title",
      "label": "Modal Title",
      "default": "Get notified when this is back"
    },
    {
      "type": "checkbox",
      "id": "header_link",
      "label": "Show wishlist link in header",
      "default": true
    },
    {
      "type": "text",
      "id": "wishlist_page_url",
      "label": "Wishlist page URL",
      "info": "Where the header wishlist icon links. Create a page with this handle (default: /pages/wishlist).",
      "default": "/pages/wishlist"
    },
    {
      "type": "checkbox",
      "id": "card_hearts",
      "label": "Show wishlist heart on product cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "product_button",
      "label": "Show wishlist heart & notify on product pages",
      "info": "Automatically adds the heart and the back-in-stock \"Notify me\" button to product pages, without placing the Wishlist Button block by hand.",
      "default": true
    }
  ]
}
{% endschema %}
