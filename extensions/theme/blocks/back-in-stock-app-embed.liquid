{% comment %}
  Back-in-Stock App Embed – notify button injection + subscription modal + config.
  This is the BACK-IN-STOCK half of the single theme extension. It can be enabled
  or disabled independently from the Wishlist App Embed in the theme editor.
{% endcomment %}

{{ 'back-in-stock.css' | asset_url | stylesheet_tag }}

<script>
  window.__wishlist_stock = window.__wishlist_stock || {};
  window.__wishlist_stock.proxyBase = window.__wishlist_stock.proxyBase || '/apps/wishlist-stock/api';
  window.__wishlist_stock.customerEmail = {{ customer.email | default: nil | json }};
  window.__wishlist_stock.customerLoggedIn = {% if customer %}true{% else %}false{% endif %};
  window.__wishlist_stock.bisSettings = {
    notifyButtonText: {{ block.settings.notify_button_text | default: "Notify me when available" | json }},
    notifyModalTitle: {{ block.settings.notify_modal_title | default: "Get notified when this is back" | json }},
    productButton: {% if block.settings.product_button == false %}false{% else %}true{% endif %},
    buttonColor: {{ block.settings.bis_button_color | default: "#e74c3c" | json }},
    buttonSize: {{ block.settings.bis_button_size | default: 14 }},
    buttonStyle: {{ block.settings.bis_button_style | default: "outlined" | json }},
    iconType: {{ block.settings.bis_icon_type | default: "bell" | json }},
    iconImage: {% if block.settings.bis_icon_image %}{{ block.settings.bis_icon_image | image_url: width: 100 | json }}{% else %}null{% endif %},
    borderRadius: {{ block.settings.bis_border_radius | default: 8 }},
  };

  /* Inject Back-in-Stock theme CSS custom properties */
  (function() {
    var s = window.__wishlist_stock.bisSettings;
    var root = document.documentElement;
    root.style.setProperty('--ws-bis-primary', s.buttonColor || '#e74c3c');
    root.style.setProperty('--ws-radius', (s.borderRadius || 8) + 'px');
  })();
</script>

{%- comment -%} Back-in-Stock modal {%- endcomment -%}
<div class="ws-modal-overlay" id="ws-bis-modal" aria-hidden="true">
  <div class="ws-modal" role="dialog" aria-label="Back in stock notification">
    <div class="ws-modal__header">
      <h3 class="ws-modal__title">{{ block.settings.notify_modal_title | default: 'Get notified when this is back' }}</h3>
      <button class="ws-modal__close" id="ws-bis-close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="ws-modal__body" id="ws-bis-form-body">
      <p>We'll email you the moment this item is available again.</p>
      <p class="ws-modal__msg" id="ws-bis-msg" role="alert" style="display:none;"></p>
      <form class="ws-modal__form" id="ws-bis-form">
        <input type="hidden" name="variantId" value="" />
        <input type="hidden" name="productId" value="" />
        <div class="ws-hp" aria-hidden="true">
          <label for="ws-bis-website">Website</label>
          <input type="text" name="website" id="ws-bis-website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="ws-modal__field">
          <label for="ws-bis-email">Email *</label>
          <input type="email" name="email" id="ws-bis-email" placeholder="you@example.com" required autocomplete="email" />
        </div>
        <div class="ws-modal__field">
          <label for="ws-bis-phone">Phone (optional)</label>
          <input type="tel" name="phone" id="ws-bis-phone" placeholder="+1 234 567 890" autocomplete="tel" />
        </div>
      </form>
    </div>
    <div class="ws-modal__actions" id="ws-bis-actions">
      <button class="ws-btn" id="ws-bis-cancel" type="button">Cancel</button>
      <button class="ws-btn ws-btn--primary" id="ws-bis-submit" type="button">Notify Me</button>
    </div>
    <div class="ws-modal__success" id="ws-bis-success" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <h3 id="ws-bis-success-title">You're on the list!</h3>
      <p id="ws-bis-success-msg">We'll email you when this is back in stock.</p>
      <button class="ws-btn ws-btn--small ws-btn--danger" id="ws-bis-unsub" type="button" style="display:none;">Unsubscribe</button>
    </div>
  </div>
</div>

<script src="{{ 'back-in-stock.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Back-in-Stock",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "bis_button_color",
      "label": "Button Color",
      "default": "#e74c3c"
    },
    {
      "type": "range",
      "id": "bis_button_size",
      "label": "Button Font Size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "bis_button_style",
      "label": "Button Style",
      "options": [
        { "label": "Outlined (border only)", "value": "outlined" },
        { "label": "Filled (solid background)", "value": "filled" }
      ],
      "default": "outlined"
    },
    {
      "type": "select",
      "id": "bis_icon_type",
      "label": "Notify button icon",
      "options": [
        { "label": "Bell", "value": "bell" },
        { "label": "Clock", "value": "clock" },
        { "label": "Custom image", "value": "image" },
        { "label": "No icon", "value": "none" }
      ],
      "default": "bell"
    },
    {
      "type": "image_picker",
      "id": "bis_icon_image",
      "label": "Custom notify icon image",
      "info": "Used when Notify button icon is set to Custom image."
    },
    {
      "type": "range",
      "id": "bis_border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "text",
      "id": "notify_button_text",
      "label": "Notify Button Text",
      "default": "Notify me when available"
    },
    {
      "type": "text",
      "id": "notify_modal_title",
      "label": "Modal Title",
      "default": "Get notified when this is back"
    },
    {
      "type": "checkbox",
      "id": "product_button",
      "label": "Show notify me button on product pages",
      "info": "Automatically adds the back-in-stock \"Notify me\" button to out-of-stock product pages.",
      "default": true
    }
  ]
}
{% endschema %}
