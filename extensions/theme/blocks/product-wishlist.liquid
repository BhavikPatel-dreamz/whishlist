{% comment %}
  Product Wishlist app block (target: section).

  Placed by the merchant on the product template (e.g. under Buy Buttons) via the
  theme editor. Renders the wishlist heart and — when the current variant is
  unavailable — the "Notify me" trigger. The back-in-stock MODAL is NOT rendered
  here: it lives once, globally, in the App Embed (app-embed.liquid), so there is
  no duplicate-id. The runtime JS/CSS is likewise loaded by the App Embed.

  App blocks can't read the theme `product` object directly, so we take it through
  a `product` setting with "autofill": true (fills with the current product on a
  product template) and read `block.settings.product`.
{% endcomment %}

{%- liquid
  assign ws_product = block.settings.product
  assign ws_variant = ws_product.selected_or_first_available_variant
-%}

{%- if ws_product == blank -%}
  {%- if request.design_mode -%}
    <div class="ws-product-block ws-product-block--empty" {{ block.shopify_attributes }}>
      <p>Select a product in this block's settings to preview the wishlist button.</p>
    </div>
  {%- endif -%}
{%- else -%}
  <div class="ws-product-block" {{ block.shopify_attributes }}>
    <button
      class="wishlist-heart"
      type="button"
      data-product-id="{{ ws_product.id }}"
      data-variant-id="{{ ws_variant.id }}"
      data-product-handle="{{ ws_product.handle }}"
      aria-pressed="false"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21s-6.716-4.434-9.333-7.14C-1.333 10.9 1.333 6 6 6c2.76 0 4 2 6 2s3.24-2 6-2c4.667 0 7.333 4.9 3.333 7.86C18.716 16.566 12 21 12 21z"
            stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <span class="ws-sr-only">Add to wishlist</span>
    </button>

    {%- unless ws_variant.available -%}
      <div class="back-in-stock" data-variant-id="{{ ws_variant.id }}" data-product-id="{{ ws_product.id }}">
        <button class="notify-me" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          {{ block.settings.notify_button_text | default: 'Notify me when available' }}
        </button>
      </div>
    {%- endunless -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Wishlist Button",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "text",
      "id": "notify_button_text",
      "label": "Notify button text",
      "default": "Notify me when available"
    }
  ]
}
{% endschema %}
