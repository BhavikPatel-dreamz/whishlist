{% comment %}
  Optional variant selection for the wishlist runtime in App Control Centre.
  Data attributes are read at click time, so embed render order does not matter.
{% endcomment %}

<dialog
  id="ws-variant-selector"
  class="ws-variant-selector"
  aria-labelledby="ws-variant-title"
  data-enabled="{{ block.settings.variant_selector_enabled }}"
  data-products-root="{{ routes.root_url | escape }}"
  style="
    --ws-variant-title: {{ block.settings.title_color }};
    --ws-variant-primary-size: {{ block.settings.primary_font_size }}px;
    --ws-variant-bg: {{ block.settings.popup_background }};
    --ws-variant-heading: {{ block.settings.heading_color }};
    --ws-variant-secondary-size: {{ block.settings.secondary_font_size }}px;
    --ws-variant-button-bg: {{ block.settings.button_background }};
    --ws-variant-button-text: {{ block.settings.button_text }};
    --ws-variant-detail: {{ block.settings.product_detail_color }};
  "
>
  <form method="dialog" class="ws-variant-selector__close-form">
    <button type="submit" class="ws-variant-selector__close" aria-label="Close variant selector">&times;</button>
  </form>
  <h2 id="ws-variant-title">{{ block.settings.popup_title | escape }}</h2>
  <div class="ws-variant-selector__product">
    <img id="ws-variant-image" alt="" width="88" height="88" hidden>
    <div>
      <p id="ws-variant-product-title"></p>
      <p id="ws-variant-detail" aria-live="polite"></p>
    </div>
  </div>
  <form id="ws-variant-form">
    <label for="ws-variant-choice">{{ block.settings.choose_action_text | escape }}</label>
    <select id="ws-variant-choice" name="variant" required></select>
    <p class="ws-variant-selector__hint">Choose your preferred options to save this item to your wishlist. Sold-out variants can also be saved.</p>
    <button type="submit" class="ws-variant-selector__submit">{{ block.settings.add_button_text | escape }}</button>
  </form>
</dialog>

{% schema %}
{
  "name": "Storefront UI Elements",
  "target": "body",
  "stylesheet": "storefront-ui.css",
  "javascript": "storefront-ui.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds the wishlist variant selector. Enable App Control Centre and Show wishlist UI to use this feature. Header icons, collection buttons, and the drawer are managed in App Control Centre."
    },
    { "type": "header", "content": "Variant Selector" },
    {
      "type": "paragraph",
      "content": "Let shoppers choose their preferred size, color, or style before adding a product to their wishlist. Items are saved to their existing wishlist."
    },
    { "type": "checkbox", "id": "variant_selector_enabled", "label": "Enable/Disable", "default": false },
    { "type": "color", "id": "title_color", "label": "Variant Selector Popup Title Color", "default": "#333333" },
    { "type": "range", "id": "primary_font_size", "label": "Primary Font Size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "popup_background", "label": "Popup Background Color", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Variant Selector Section Headings Color", "default": "#000000" },
    { "type": "range", "id": "secondary_font_size", "label": "Secondary Font Size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "text", "id": "choose_action_text", "label": "Choose Options Action Text", "default": "Choose product options" },
    { "type": "color", "id": "button_background", "label": "Add to Wishlist Button Background Color", "default": "#292929" },
    { "type": "color", "id": "button_text", "label": "Add to Wishlist Button Font Color", "default": "#FFFFFF" },
    { "type": "color", "id": "product_detail_color", "label": "Product Detail Font Color", "default": "#FFFFFF" },
    { "type": "text", "id": "popup_title", "label": "Popup Title", "default": "Choose your favorites" },
    { "type": "text", "id": "add_button_text", "label": "Add to Wishlist Button Text", "default": "Add to wishlist" }
  ]
}
{% endschema %}
