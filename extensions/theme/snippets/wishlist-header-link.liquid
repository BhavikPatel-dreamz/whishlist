{% comment %}
  Wishlist Header Link – add to your header.liquid or navigation.
  Shows a heart icon with a live counter of saved items.
{% endcomment %}

<a
  href="/pages/wishlist"
  class="ws-header-link"
  id="ws-header-link"
  aria-label="My Wishlist"
>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M12 21s-6.716-4.434-9.333-7.14C-1.333 10.9 1.333 6 6 6c2.76 0 4 2 6 2s3.24-2 6-2c4.667 0 7.333 4.9 3.333 7.86C18.716 16.566 12 21 12 21z"/>
  </svg>
  <span class="ws-count" id="ws-header-count" data-count="0"></span>
  <span class="ws-sr-only">Wishlist</span>
</a>
