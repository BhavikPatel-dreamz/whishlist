{% comment %}
  Wishlist heart button snippet. Include near Add to cart on PDP or collection cards.

  Parameters (optional):
    - product: product object (uses selected_or_first_available_variant by default)
    - open_drawer: if "true", clicking the heart opens the drawer instead of toggling

  Usage:
    {% render 'wishlist-button', product: product %}
    {% render 'wishlist-button', product: product, open_drawer: true %}
{% endcomment %}

{%- liquid
  assign pid = product.id
  assign vid = product.selected_or_first_available_variant.id
-%}

<button
  class="wishlist-heart"
  data-product-id="{{ pid }}"
  data-variant-id="{{ vid }}"
  aria-pressed="false"
  {% if open_drawer == 'true' %}data-open-drawer="true"{% endif %}
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 21s-6.716-4.434-9.333-7.14C-1.333 10.9 1.333 6 6 6c2.76 0 4 2 6 2s3.24-2 6-2c4.667 0 7.333 4.9 3.333 7.86C18.716 16.566 12 21 12 21z"
        stroke="currentColor" stroke-width="1.2"/>
  </svg>
  <span class="ws-sr-only">Add to wishlist</span>
</button>
