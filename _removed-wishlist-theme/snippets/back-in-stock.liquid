{% comment %}
  Back-in-stock form snippet. Place on PDP when variant is unavailable.
  Renders a "Notify me" button that opens a modal for email/phone collection.

  Parameters (optional):
    - product: product object

  Usage:
    {% unless product.selected_or_first_available_variant.available %}
      {% render 'back-in-stock', product: product %}
    {% endunless %}
{% endcomment %}

{%- liquid
  assign vid = product.selected_or_first_available_variant.id
-%}

<div class="back-in-stock" data-variant-id="{{ vid }}">
  <button class="notify-me" type="button">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
    </svg>
    {{ settings.notify_button_text | default: 'Notify me when available' }}
  </button>
</div>

<!-- Modal (injected by back-in-stock.js) -->
<div class="ws-modal-overlay" id="ws-bis-modal" aria-hidden="true">
  <div class="ws-modal" role="dialog" aria-label="Back in stock notification">
    <div class="ws-modal__header">
      <h3 class="ws-modal__title">{{ settings.notify_modal_title | default: 'Get notified when this is back' }}</h3>
      <button class="ws-modal__close" id="ws-bis-close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="ws-modal__body" id="ws-bis-form-body">
      <p>We'll email you the moment this item is available again.</p>
      <form class="ws-modal__form" id="ws-bis-form">
        <input type="hidden" name="variantId" value="{{ vid }}" />
        <input type="hidden" name="productId" value="{{ product.id }}" />
        <div class="ws-hp" aria-hidden="true">
          <label for="ws-bis-website">Website</label>
          <input type="text" name="website" id="ws-bis-website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="ws-modal__field">
          <label for="ws-bis-email">Email *</label>
          <input type="email" name="email" id="ws-bis-email" placeholder="you@example.com" required autocomplete="email" />
        </div>
        <div class="ws-modal__field">
          <label for="ws-bis-phone">Phone (optional)</label>
          <input type="tel" name="phone" id="ws-bis-phone" placeholder="+1 234 567 890" autocomplete="tel" />
        </div>
      </form>
    </div>
    <div class="ws-modal__actions" id="ws-bis-actions">
      <button class="ws-btn" id="ws-bis-cancel" type="button">Cancel</button>
      <button class="ws-btn ws-btn--primary" id="ws-bis-submit" type="button">Notify Me</button>
    </div>
    <div class="ws-modal__success" id="ws-bis-success" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <h3>You're on the list!</h3>
      <p id="ws-bis-success-msg">We'll email you when this is back in stock.</p>
    </div>
  </div>
</div>
