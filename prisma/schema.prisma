// Wishlist & Back-in-Stock Notifications — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shopify OAuth sessions (managed by @shopify/shopify-app-session-storage-prisma).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// One row per installed store. Holds merchant-configured notification settings.
model Shop {
  id          String   @id @default(uuid())
  shop        String   @unique // myshop.myshopify.com
  accessToken String? // mirror of the offline token; Session remains the source of truth
  installedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Notification settings ---
  emailProvider String  @default("mailgun") // mailgun (default/inbuilt) | brevo | klaviyo | resend | sendgrid
  apiKey        String? // provider API key (encrypted at rest, see app/lib/crypto.server.ts)
  brevoApiKey   String? @ignore // legacy provider-specific columns, not used by Prisma Client
  mailgunApiKey String? @ignore
  klaviyoApiKey String? @ignore
  resendApiKey  String? @ignore
  sendgridApiKey String? @ignore
  senderEmail   String?
  senderName    String?
  emailSubject  String  @default("{{ product_title }} is back in stock!")
  emailHeading  String  @default("Good news — it's back!")
  emailBody     String  @default("The item you were waiting for is available again. Tap below before it sells out.")
  buttonLabel   String  @default("Buy it now")
  stockAlertDeliveryMode   String @default("immediate") // immediate | scheduled
  stockAlertDeliveryTime   String @default("09:00") // HH:MM local store time

  // --- SMS (optional) ---
  emailAlertsEnabled Boolean @default(true)
  smsEnabled       Boolean @default(false)
  twilioAccountSid String?
  twilioAuthToken  String? // encrypted at rest
  twilioFromNumber String?
  whatsappEnabled  Boolean @default(false)
  whatsappFromNumber String?

  // --- Storefront behaviour ---
  wishlistRequiresLogin Boolean @default(false)
  doubleOptIn           Boolean @default(false)
  alertsPerVariantCap   Int     @default(0) // 0 = unlimited

  wishlistShares  WishlistShare[]
  wishlistLists   WishlistList[]
  wishlists       WishlistItem[]
  wishlistEvents  WishlistEvent[]
  wishlistMetrics WishlistMetric[]
  wishlistCartDays WishlistCartDay[]
  wishlistOrders  WishlistOrder[]
  shopifyOrders   ShopifyOrderRecord[]
  stockAlerts     StockAlert[]
  webhookEvents   WebhookEvent[]
  rateLimits      RateLimitBucket[]
  uiConfig        UIConfig?

  // --- Analytics ---
  settings        ShopSettings?
  trackingEvents  TrackingEvent[]
  notificationLogs NotificationLog[]
  attributions    Attribution[]
  inventoryCache  InventoryCache[]
  dailyStats      DailyStat[]
  billingSubscriptions BillingSubscription[]
  usageCounters        UsageCounter[]
  usageLedger          UsageLedger[]
}

/// A saved product. Keyed by Shopify customer id when logged in, else by a browser guest token.
model WishlistItem {
  id         String   @id @default(uuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String? // numeric Shopify customer id, null for anonymous visitors
  guestToken String? // uuid persisted in localStorage for non-logged-in visitors
  productId  String // numeric product id
  variantId  String? // numeric variant id
  listName   String   @default("My Wishlist")
  handle     String? // cached product handle for fast storefront links
  createdAt  DateTime @default(now())

  // --- Analytics ---
  shopperId  String? // unified identity: customer id when logged in, else the guest token
  source     String? // where the save happened: pdp | collection | search | cart | other
  device     String? // desktop | mobile | tablet

  @@unique([shopId, customerId, productId, variantId], name: "customer_product")
  @@unique([shopId, guestToken, productId, variantId], name: "guest_product")
  @@index([shopId, customerId])
  @@index([shopId, guestToken])
  @@index([shopId, productId])
  @@index([shopId, createdAt])
}

/// Audit trail of removed wishlist items so all-time reports can show products
/// that were wishlisted in the past even after the saved row was deleted.
model WishlistEvent {
  id         String    @id @default(uuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  itemId     String? // the deleted WishlistItem id
  customerId String?
  guestToken String?
  productId  String
  variantId  String?
  type       String    @default("remove") // remove | clear (reserved)
  createdAt  DateTime  @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, productId])
}

/// A "notify me when available" subscription for one variant.
model StockAlert {
  id           String    @id @default(uuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId   String?
  email        String?
  phone        String?
  channel      String    @default("email")
  contactKey   String
  productId    String
  variantId    String
  productTitle String?
  variantTitle String?
  locale       String?
  // PENDING → SENDING → SENT | FAILED, or CANCELLED when the shopper unsubscribes.
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  /// Increments when a shopper subscribes again after SENT, FAILED, or CANCELLED.
  notifyGeneration Int   @default(1)
  lastError    String?
  notifiedAt   DateTime?
  convertedAt  DateTime? // set when the recipient's click leads back to the PDP/cart
  purchaseOrderId String?
  purchaseRevenue Decimal? @db.Decimal(12, 2)
  purchaseCurrency String?
  purchasedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // --- Analytics ---
  shopperId    String? // unified identity: customer id when logged in, else the contact key
  source       String? // where the signup happened: pdp | collection | search | cart | other
  device       String? // desktop | mobile | tablet
  confirmed    Boolean  @default(true) // double opt-in: false until the shopper confirms
  pendingReason String? // out_of_stock | queued | unconfirmed

  @@unique([shopId, variantId, contactKey], name: "one_alert_per_contact_variant")
  @@index([shopId, variantId, status])
  @@index([shopId, status, createdAt])
  @@index([shopId, purchasedAt])
  @@index([shopId, productId, status])
  @@index([shopId, customerId])
  @@index([shopId, status, updatedAt])
  @@index([shopId, createdAt])
}

/// Webhook de-duplication: Shopify redelivers, and a restock can fire several inventory events.
model WebhookEvent {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  webhookId   String // X-Shopify-Webhook-Id
  topic       String
  processedAt DateTime @default(now())

  @@unique([shopId, webhookId])
  @@index([processedAt])
}

/// Fixed-window rate limiting for the public App Proxy endpoints.
model RateLimitBucket {
  id          String   @id @default(uuid())
  shopId      String?
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  key         String // e.g. "stock-alert:1.2.3.4"
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}

/// Per-store UI configuration: product card options, theme settings and active extension toggle
model UIConfig {
  id                String @id @default(uuid())
  shopId            String @unique
  shop              Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Which extension is active for this store (none | wishlist | back_in_stock | both)
  extensionActive   String @default("none")
  // Product card configuration stored as JSON for flexibility and future fields
  productCardConfig Json?
  // Theme settings (colors, border radius, button style) stored as JSON
  themeSettings     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Date-specific cart adds in UTC; historical totals cannot be assigned dates.
model WishlistCartDay {
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  count Int @default(0)
  pageViews Int @default(0)

  @@id([shopId, date])
}

/// Aggregated metrics for wishlisted products (adds-to-cart and purchases)
model WishlistMetric {
  id         String   @id @default(uuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId  String?
  addsToCart Int ?     @default(0)
  purchases  Int ?     @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([shopId, productId])
}

/// A paid order line that can be attributed to a product that was saved in a wishlist.
/// The unique key makes processing safe when Shopify sends both orders/paid and
/// orders/updated (or retries either webhook).
model WishlistOrder {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId   String
  productId String
  createdAt DateTime @default(now())

  @@unique([shopId, orderId, productId])
  @@index([shopId, createdAt])
}

/// Shopify orders and their line items, mirrored for store reporting and backfills.
model ShopifyOrderRecord {
  id                 String             @id @default(uuid())
  shopId             String
  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId            String
  orderNumber        String
  customerId         String?
  currency           String?
  financialStatus    String?
  fulfillmentStatus  String?
  totalPrice         Decimal            @default(0) @db.Decimal(12, 2)
  createdAtShopify   DateTime
  processedAt        DateTime?
  updatedAtShopify   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lines              ShopifyOrderLine[]

  @@unique([shopId, orderId])
  @@index([shopId, createdAtShopify])
  @@index([shopId, customerId, createdAtShopify])
}

model ShopifyOrderLine {
  id              String            @id @default(uuid())
  orderRecordId   String
  order           ShopifyOrderRecord @relation(fields: [orderRecordId], references: [id], onDelete: Cascade)
  lineItemId      String
  productId       String?
  variantId       String?
  title           String?
  variantTitle    String?
  sku             String?
  quantity        Int
  unitPrice       Decimal           @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal           @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal           @default(0) @db.Decimal(12, 2)

  @@unique([orderRecordId, lineItemId])
  @@index([productId])
  @@index([variantId])
}

/// Customer-initiated share actions with product IDs captured at sharing time.
model WishlistShare {
  id String @id @default(uuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  mode String
  listName String?
  products Json
  createdAt DateTime @default(now())
  @@index([shopId, createdAt])
}

/// Named lists are scoped to an authenticated customer or an opaque guest token.
model WishlistList {
  id String @id @default(uuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  owner String
  name String
  createdAt DateTime @default(now())

  @@unique([shopId, owner, name])
}

// ---------------------------------------------------------------------------
// Analytics — see ANALYTICS_REPORTS_SPEC.md sections 4 and 7.
// These tables are additive: the wishlist/back-in-stock tables above keep
// serving the storefront, and the analytics tables serve the reports.
// ---------------------------------------------------------------------------

/// Per-store analytics settings (attribution windows, thresholds, timezone).
model ShopSettings {
  shopId             String   @id
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  wishlistWindowDays Int      @default(14)
  restockWindowDays  Int      @default(7)
  abandonedAfterDays Int      @default(30)
  lowStockThreshold  Int      @default(5)
  timezone           String   @default("UTC")
  weeklyReportEmail  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Storefront events, appended on every tracked interaction.
enum EventType {
  PRODUCT_VIEW
  WISHLIST_SAVE
  WISHLIST_REMOVE
  WISHLIST_ADD_TO_CART
  WISHLIST_SHARE
  WISHLIST_SHARE_VISIT
  ALERT_FORM_VIEW
  ALERT_SUBSCRIBE
  ALERT_SUBSCRIBE_CLICK
  NOTIFICATION_CLICK
}

/// Append-only event log for the storefront tracking endpoint.
model TrackingEvent {
  id         String    @id @default(uuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopperId  String
  customerId String?
  type       EventType
  productId  String?
  variantId  String?
  channel    String? // share channel: link | email | social
  source     String?
  device     String?
  meta       Json?
  createdAt  DateTime  @default(now())

  @@index([shopId, type, createdAt])
  @@index([shopId, productId, type])
  @@index([shopId, shopperId, createdAt])
}

/// What a notification was about.
enum NotifKind {
  RESTOCK
  WISHLIST_REMINDER
  PRICE_DROP
  LOW_STOCK_NUDGE
}

/// Delivery channel of a notification.
enum Channel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

/// One row per notification attempt, with its delivery timeline.
model NotificationLog {
  id                String    @id @default(uuid())
  shopId            String
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind              NotifKind
  channel           Channel
  subscriptionId    String?
  wishlistItemId    String?
  shopperId         String
  productId         String
  variantId         String?
  status            String // queued | sent | delivered | bounced | failed
  errorReason       String?
  retryCount        Int       @default(0)
  restockedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  unsubscribedAt    DateTime?
  createdAt         DateTime  @default(now())

  @@index([shopId, kind, sentAt])
  @@index([shopId, status, sentAt])
  @@index([shopId, subscriptionId])
}

/// Which feature produced the attribution.
enum AttrSource {
  WISHLIST
  RESTOCK_ALERT
}

/// Whether the attribution is proven (direct) or inferred (estimated).
enum AttrType {
  DIRECT
  ESTIMATED
}

/// One attributed order line. `model` selects the attribution rule set:
/// `last_click` keeps one row per line, `any_touch` keeps every qualifying touch.
model Attribution {
  id                String     @id @default(uuid())
  shopId            String
  shop              Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId           String
  lineItemId        String
  orderNumber       String
  customerId        String?
  shopperId         String?
  productId         String
  variantId         String?
  source            AttrSource
  type              AttrType
  model             String     @default("last_click")
  notificationLogId String?
  wishlistItemId    String?
  revenue           Decimal    @default(0) @db.Decimal(12, 2)
  quantity          Int        @default(1)
  orderedAt         DateTime
  touchAt           DateTime // when the qualifying save/click happened

  @@unique([shopId, lineItemId, source, model])
  @@index([shopId, orderedAt])
  @@index([shopId, productId, orderedAt])
  @@index([shopId, source, type, orderedAt])
}

/// Cached variant inventory so reports never have to walk every product.
model InventoryCache {
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId        String
  productId        String
  quantity         Int      @default(0)
  status           String   @default("in_stock") // in_stock | low_stock | out_of_stock
  price            Decimal? @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt
  lastOutOfStockAt DateTime?
  lastRestockedAt  DateTime?

  @@id([shopId, variantId])
  @@index([shopId, status])
}

/// One row per shop per day — the rollup every report summary reads from.
model DailyStat {
  shopId String
  shop   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  productViews          Int @default(0)
  wishlistSaves         Int @default(0)
  wishlistRemoves       Int @default(0)
  uniqueSavers          Int @default(0)
  wishlistAddToCart     Int @default(0)
  shares                Int @default(0)
  shareVisits           Int @default(0)
  alertSubscriptions    Int @default(0)
  pendingAlerts         Int @default(0)
  notificationsSent     Int @default(0)
  notificationsDelivered Int @default(0)
  notificationsOpened   Int @default(0)
  notificationClicks    Int @default(0)
  unsubscribes          Int @default(0)
  wishlistOrders        Int @default(0)
  restockOrders         Int @default(0)
  wishlistRevenueDirect    Decimal @default(0) @db.Decimal(12, 2)
  wishlistRevenueEstimated Decimal @default(0) @db.Decimal(12, 2)
  restockRevenueDirect     Decimal @default(0) @db.Decimal(12, 2)
  restockRevenueEstimated  Decimal @default(0) @db.Decimal(12, 2)

  @@id([shopId, date])
}

/// Catalog of notification plans. Allowance numbers live here, not in send-path code.
model Plan {
  code                            String   @id // free | pro | gold
  name                            String
  monthlyPriceCents               Int
  /// Emails allowed per allowanceWindow.
  allowance                       Int
  /// month (Free) or day (paid). Windows are UTC calendar periods.
  allowanceWindow                 String
  allowMerchantProvider           Boolean  @default(false)
  /// When true, merchant-owned provider sends consume the same allowance.
  merchantSendsCountTowardQuota   Boolean  @default(true)
  active                          Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  subscriptions BillingSubscription[]
}

/// Shopify app subscription for one shop. No in-force row means the Free plan.
model BillingSubscription {
  id               String    @id @default(uuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planCode         String
  plan             Plan      @relation(fields: [planCode], references: [code])
  /// Shopify AppSubscription GID. Null for an optional locally recorded Free row.
  shopifyGid       String?   @unique
  /// ACTIVE, CANCELLED, EXPIRED, FROZEN, PENDING
  status           String
  /// Paid access continues until this instant when Shopify cancels at period end.
  currentPeriodEnd DateTime?
  test             Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shopId, status])
  @@index([shopId, currentPeriodEnd])
}

/// Quota window for one shop. Period keys are UTC calendar months or days.
model UsageCounter {
  id             String   @id @default(uuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  periodKey      String
  reservedCount  Int      @default(0)
  consumedCount  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([shopId, periodKey])
}

/// One logical notification. Retries reuse the row instead of consuming quota again.
model UsageLedger {
  id              String   @id @default(uuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stockAlertId    String
  idempotencyKey  String   @unique
  periodKey       String
  /// reserved | consumed | released
  state           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shopId, periodKey])
  @@index([stockAlertId])
}

/// Shopify shop profile captured at install / shop/update. Separate from operational `Shop`.
model Store {
  id                    String    @id @default(cuid())
  shopDomain            String    @unique
  shopifyShopId         String?
  name                  String?
  email                 String?
  contactEmail          String?
  description           String?
  url                   String?
  primaryDomain         String?
  currency              String?
  timezone              String?
  timezoneOffset        String?
  weightUnit            String?
  unitSystem            String?
  planName              String?
  isDevStore            Boolean   @default(false)
  isShopifyPlus         Boolean   @default(false)
  address               Json?
  billingAddress        Json?
  presentmentCurrencies Json?
  currencyFormats       Json?
  taxesIncluded         Boolean?
  taxShipping           Boolean?
  checkoutApiSupported  Boolean?
  setupRequired         Boolean?
  shipsToCountries      Json?
  features              Json?
  resourceLimits        Json?
  paymentSettings       Json?
  shopLocales           Json?
  themes                Json?
  publications          Json?
  accessScopes          Json?
  activeSubscriptions   Json?
  uninstallUrl          String?
  shopCreatedAt         DateTime?
  scopes                String?
  isActive              Boolean   @default(true)
  installCount          Int       @default(1)
  installedAt           DateTime  @default(now())
  uninstalledAt         DateTime?
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())

  installer   StoreInstaller?
  locations   StoreLocation[]
  markets     StoreMarket[]
  stats       StoreStats[]
  events      StoreInstallEvent[]
}

/// Staff account that installed the app (online session only; skipped when unavailable).
model StoreInstaller {
  id            String   @id @default(cuid())
  storeId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyUserId String?
  firstName     String?
  lastName      String?
  email         String?
  locale        String?
  accountOwner  Boolean  @default(false)
  collaborator  Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model StoreLocation {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyLocationId String
  name              String?
  isActive          Boolean  @default(true)
  isPrimary         Boolean  @default(false)
  address           Json?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@unique([storeId, shopifyLocationId])
  @@index([storeId])
}

model StoreMarket {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyMarketId String
  name            String?
  handle          String?
  primary         Boolean  @default(false)
  enabled         Boolean  @default(true)
  raw             Json?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([storeId, shopifyMarketId])
  @@index([storeId])
}

/// Snapshot of resource counts only — never customer PII.
model StoreStats {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productsCount   Int      @default(0)
  collectionsCount Int     @default(0)
  ordersCount     Int      @default(0)
  customersCount  Int      @default(0)
  capturedAt      DateTime @default(now())

  @@index([storeId, capturedAt])
}

model StoreInstallEvent {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// INSTALL | REINSTALL | UNINSTALL | SCOPES_UPDATE
  type       String
  scopes     String?
  appVersion String?
  utmSource  String?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([type])
}
