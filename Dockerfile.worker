FROM node:20-alpine
RUN apk add --no-cache openssl libc6-compat
# Match local lockfile (pnpm 12 / lockfileVersion 9).
RUN corepack enable && corepack prepare pnpm@12.6.0 --activate

WORKDIR /app

ENV NODE_ENV=production

# pnpm 12 reads allowBuilds from pnpm-workspace.yaml (not package.json#pnpm).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma

RUN (pnpm install --frozen-lockfile --prod || pnpm install --prod) \
  && pnpm exec prisma generate \
  && pnpm store prune

COPY app ./app
COPY tsconfig.json ./

CMD ["pnpm", "exec", "tsx", "app/workers/restock-worker.server.ts"]
